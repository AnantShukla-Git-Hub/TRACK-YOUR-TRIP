{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend-trip/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend-trip/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend-trip/dist/$1"
    }
  ],
  "outputDirectory": "frontend-trip/dist",
  "installCommand": "cd frontend-trip && npm install",
  "buildCommand": "cd frontend-trip && npm run build",
  "env": {
    "PYTHON_VERSION": "3.11"
  }
}
